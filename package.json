{
  "name": "audiolib",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "desktop": "vite build && electron .",
    "dist:linux": "vite build && electron-builder --linux AppImage deb --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/local-notifications": "^6.1.0",
    "@jofr/capacitor-media-session": "latest",
    "@capgo/inappbrowser": "^6.0.0",
    "@aparajita/capacitor-biometric-auth": "^8.0.2",
    "@capacitor/screen-orientation": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "description": "مكتبتي الصوتية",
  "author": {
    "name": "audiolib",
    "email": "audiolib@example.com"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.me.audiolib",
    "productName": "AudioLib",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "audiolib <audiolib@example.com>"
    }
  }
}